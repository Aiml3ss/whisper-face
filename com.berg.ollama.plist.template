<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.berg.ollama</string>

    <key>ProgramArguments</key>
    <array>
        <string>__OLLAMA__</string>
        <string>serve</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>Umask</key>
    <integer>63</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- +36% generation speed on Apple Silicon, measured 2026-07-20 -->
        <key>OLLAMA_FLASH_ATTENTION</key>
        <string>1</string>
        <!-- one slot -> repeated identical prompts hit the KV cache -->
        <key>OLLAMA_NUM_PARALLEL</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__DIR__/ollama.log</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/ollama.log</string>
</dict>
</plist>
