{
  "schema_version": 1,
  "profiles": {
    "ci_warm_path": {
      "description": "Deterministic, platform-independent Voice Compiler tail-latency release gate. The threshold is deliberately tolerant of shared CI runners while still catching hangs and order-of-magnitude regressions.",
      "checks": [
        {
          "id": "compiler-p95",
          "metric": "latency_ms.compiler.p95",
          "samples_metric": "latency_ms.compiler.samples",
          "minimum_samples": 30,
          "operator": "<=",
          "threshold": 50.0,
          "unit": "ms"
        }
      ]
    },
    "warm_path_stage": {
      "description": "Per-stage warm-path latency guardrails aggregated from a collected warm_path trace log. Thresholds are deliberately tolerant of shared CI runners and only catch hangs and order-of-magnitude regressions; they do not assert steady-state or physical dictation conditions. Samples are gated so a thin trace log reports insufficient-samples rather than a misleading pass.",
      "checks": [
        {
          "id": "release-p95",
          "metric": "latency_ms.release.p95",
          "samples_metric": "latency_ms.release.samples",
          "minimum_samples": 20,
          "operator": "<=",
          "threshold": 5000.0,
          "unit": "ms"
        },
        {
          "id": "asr-p95",
          "metric": "latency_ms.asr.p95",
          "samples_metric": "latency_ms.asr.samples",
          "minimum_samples": 20,
          "operator": "<=",
          "threshold": 15000.0,
          "unit": "ms"
        },
        {
          "id": "compiler-p95",
          "metric": "latency_ms.compiler.p95",
          "samples_metric": "latency_ms.compiler.samples",
          "minimum_samples": 20,
          "operator": "<=",
          "threshold": 2000.0,
          "unit": "ms"
        },
        {
          "id": "cleanup-p95",
          "metric": "latency_ms.cleanup.p95",
          "samples_metric": "latency_ms.cleanup.samples",
          "minimum_samples": 20,
          "operator": "<=",
          "threshold": 5000.0,
          "unit": "ms"
        },
        {
          "id": "context-p95",
          "metric": "latency_ms.context.p95",
          "samples_metric": "latency_ms.context.samples",
          "minimum_samples": 20,
          "operator": "<=",
          "threshold": 2000.0,
          "unit": "ms"
        },
        {
          "id": "insertion-p95",
          "metric": "latency_ms.insertion.p95",
          "samples_metric": "latency_ms.insertion.samples",
          "minimum_samples": 20,
          "operator": "<=",
          "threshold": 2000.0,
          "unit": "ms"
        }
      ]
    },
    "startup_readiness": {
