          "samples_metric": "phases.cold.events.warmup_audio_pool.records",
          "minimum_samples": 3,
          "operator": "<=",
          "threshold": 2000.0,
          "unit": "ms"
        },
        {
          "id": "cold-asr-tiny-p95",
