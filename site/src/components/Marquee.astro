---
const apps = [
  'Mail',
  'Slack',
  'Notes',
  'VS Code',
  'Messages',
  'Google Docs',
  'Notion',
  'the terminal',
  'Figma',
  'your notes app',
];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    <span>
      {apps.map((a) => (<>{a}<b class="star">✦</b></>))}
    </span>
    <span>
      {apps.map((a) => (<>{a}<b class="star">✦</b></>))}
    </span>
  </div>
</div>
<p class="sr-only">
  Whisper Face types into the text field you are using on your Mac.
</p>
