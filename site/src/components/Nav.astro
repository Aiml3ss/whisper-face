---
import Face from './Face.astro';
---

<header class="nav">
  <div class="wrap">
    <a class="brand" href="/">
      <span class="mark"><Face animal="parrot" /></span>Whisper&nbsp;Face
    </a>
    <nav class="nav-links">
      <a href="/#faces">Faces</a>
      <a href="/#how">How it works</a>
      <a href="/#privacy">Privacy</a>
      <a href="/docs">Docs</a>
      <a href="/blog">Blog</a>
    </nav>
    <div class="nav-right">
      <jelly-button
        class="theme-toggle"
        data-theme-toggle
        label="Toggle light and dark theme"
        size="small"
        shape="square"
        variant="graphite"
      >◐</jelly-button>
      <a class="btn btn-ghost btn-sm" data-jelly href="https://github.com/Aiml3ss/whisper-face" aria-label="Star Whisper Face on GitHub">★ Star</a>
      <a class="btn btn-primary btn-sm" data-jelly href="/#install">Download</a>
    </div>
  </div>
</header>
