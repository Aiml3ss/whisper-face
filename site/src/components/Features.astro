---
const features = [
  {
    icon: '🖥️',
    color: 'var(--parrot)',
    title: 'Runs entirely on your machine',
    body: 'A stack of local recognizers turns speech into text on-device. No cloud, no API keys. Pull the Wi-Fi and it still works.',
  },
  {
    icon: '🎯',
    color: 'var(--fox)',
    title: 'Types into the right place',
    body: 'It leases the field under your cursor and checks it is still there before pasting once. If focus moved, the text parks safely in your Outbox instead of the wrong box.',
  },
  {
    icon: '⚡',
    color: 'var(--bear)',
    title: "Fast enough to forget",
    body: 'Models stay warm and long sentences are recognized while you are still talking, so the text is ready the moment you let go of the key.',
  },
  {
    icon: '✍️',
    color: 'var(--owl)',
    title: 'Cleans up, never makes things up',
    body: 'The Voice Compiler smooths filler and formatting, but it cannot invent words you did not say. Your names, numbers, and code stay exactly as spoken.',
  },
  {
    icon: '📓',
    color: 'var(--cat)',
    title: 'Learns your words, not your life',
    body: 'Corrections become small, local rules you can read and delete. There is no cloud transcript following you around.',
  },
  {
    icon: '🛟',
    color: 'var(--teal)',
    title: 'Nothing gets lost',
    body: 'Faithful fallbacks, exact-once insertion, and a recoverable Outbox mean a bad moment never eats your sentence.',
  },
  {
    icon: '⏪',
    color: 'var(--pig)',
    title: 'Talk first, decide after',
    body: 'Turn on Flight Recorder and the last twenty seconds live in memory, never on disk. Say the thing, realise you wanted it, tap the key and keep it.',
  },
  {
    icon: '🎚️',
    color: 'var(--wolf)',
    title: 'Six ways to say it',
    body: 'Hold a modifier with your key: compose polished prose, reply using what is on screen, edit the text you selected, or dictate code with real punctuation.',
  },
  {
    icon: '🔍',
    color: 'var(--tiger)',
    title: 'Show your work',
    body: 'Every result can explain itself — what it protected, which edits it accepted or refused, what it was unsure about. No transcript dossier required.',
  },
];
---

<section class="band wrap" id="features">
  <div class="sec-head">
    <span class="kicker">Why it feels different</span>
    <h2>An interface between thought and software.</h2>
    <p>Not another transcript box. Every part is built to earn your trust with what you actually said.</p>
    <p class="sec-note">
      Described as they work on a Mac. Windows shares capture, recognition, cleanup, snippets and
      tones, but not the verified insertion transaction, the Outbox, correction learning, or the
      results view — see <a href="/docs/comparison">how it compares</a>.
    </p>
  </div>

  <div class="features">
    {
      features.map((f) => (
        <article class="feature" data-jelly>
          <div class="badge" style={`background:${f.color}`}>{f.icon}</div>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </article>
      ))
    }
  </div>
</section>
