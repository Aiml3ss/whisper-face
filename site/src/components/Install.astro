---
import { RELEASE } from '../data/release';

const macSteps = [
  {
    h: 'Download and open',
    p: 'Grab the disk image and open it. No account, no sign-up wall.',
  },
  {
    h: 'Copy it to a folder of its own',
    p: 'Drag the Whisper Face folder and the app beside it out of the disk image into a new folder in your home folder, such as Whisper Face. Your dictation history lives in that folder, so avoid Documents or Desktop if iCloud Drive syncs them. The installer will not run from the read-only image.',
  },
  ...(RELEASE.unsigned
    ? [
        {
          h: 'Let macOS open it',
          p: 'The build is not notarized, so macOS blocks Install.command the first time. On macOS 15 or later, open it once, choose Done, then go to System Settings → Privacy & Security and choose Open Anyway; macOS asks for your password. On macOS 14, Control-click Install.command, choose Open, then confirm.',
        },
      ]
    : []),
  {
    h: 'Run Install.command',
    p: 'It needs an administrator account and the Xcode Command Line Tools, installs Homebrew if you do not have it, and downloads a few gigabytes on a fresh Mac — allow 15 to 45 minutes. Then it builds the speech helper, sets up the login service, and checks its own work.',
  },
  {
    h: 'Turn on three permissions',
    p: 'In System Settings → Privacy & Security, turn on Whisper Face under Input Monitoring (so it notices you holding the key), Accessibility (so it can type for you), and Microphone (macOS asks the first time you dictate).',
  },
];

const platforms = [
  {
    id: 'mac',
    label: 'Mac',
    href: RELEASE.dmg,
    meta: `${RELEASE.version} · ${RELEASE.size} disk image`,
    requires:
      'Apple Silicon, macOS 14 or newer, an administrator account, about 5 GB free. The disk image is small; the installer downloads the speech models and tools.',
    checksums: RELEASE.checksums,
    checksumLabel: 'SHA256SUMS (Mac)',
    warn: RELEASE.unsigned
      ? 'This build is not signed or notarized yet, so macOS will warn you before it runs. Step 3 shows the way through.'
      : '',
    steps: macSteps,
  },
  {
    id: 'windows',
    label: 'Windows',
    href: RELEASE.windows,
    meta: `${RELEASE.version} · ${RELEASE.windowsSize} zip${RELEASE.windowsPreview ? ' · preview' : ''}`,
    requires:
      'Windows 10 or 11, 64-bit, winget, about 8 GB free. The installer downloads the speech models, a local cleanup model, and tools.',
    checksums: RELEASE.windowsChecksums,
    checksumLabel: 'SHA256SUMS-windows',
    warn: RELEASE.windowsPreview
      ? 'Windows is an unverified preview: neither its installer nor a full dictation has been run on real Windows hardware, and it may not install. It is also not code-signed, so SmartScreen will warn you.'
      : '',
    steps: [
      {
        h: 'Download and unzip',
        p: 'Unzip it into a folder of its own, such as C:\\Users\\you\\Whisper Face. Your dictation history lives in that folder, so avoid Documents or Desktop if OneDrive syncs them. The installer will not run from inside the zip.',
      },
      {
        h: 'Run Install.cmd',
        p: 'Double-click it — it starts the bundled setup script, which Windows blocks if you launch it directly. One repeatable flow sets up the app, locked dependencies, models, a login task, and health checks, and it is safe to run again later. It needs winget (App Installer, from the Microsoft Store) the first time.',
      },
      {
        h: 'Let SmartScreen through',
        p: 'The build is not code-signed, so Windows may say it protected your PC. Choose More info, then Run anyway — or check the zip against SHA256SUMS-windows first.',
      },
      {
        h: 'Hold Right Alt and talk',
        p: 'Windows uses Right Alt in place of Right Option, and Whisper Face lives in the tray rather than the menu bar.',
      },
    ],
  },
];
---

<section class="band wrap" id="install">
  <div class="sec-head">
    <span class="kicker">Get started</span>
    <h2>Setup is part of the product.</h2>
    <p>One installer sets everything up and checks its own work. Then hold your key and talk.</p>
  </div>

  <div class="install-grid">
    <div class="install-steps">
      <div class="platform-tabs" role="tablist" aria-label="Choose your platform">
        {
          platforms.map((platform, index) => (
            <button
              type="button"
              class="platform-tab"
              role="tab"
              id={`tab-${platform.id}`}
              aria-controls={`panel-${platform.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-platform={platform.id}
              data-jelly
            >
              {platform.label}
            </button>
          ))
        }
      </div>

      {
        platforms.map((platform, index) => (
          <div
            class="platform-panel"
            role="tabpanel"
            id={`panel-${platform.id}`}
            aria-labelledby={`tab-${platform.id}`}
            data-platform={platform.id}
            hidden={index !== 0}
          >
            <ol class="isteps">
              {platform.steps.map((s, i) => (
                <li class="istep" data-jelly>
                  <div class="n" aria-hidden="true">{i + 1}</div>
                  <div>
                    <h3>{s.h}</h3>
                    <p>{s.p}</p>
                  </div>
                </li>
              ))}
            </ol>
            {platform.warn && <p class="install-warn">{platform.warn}</p>}
            <div class="cta-row" style="margin-top:8px">
              <a class="btn btn-primary" data-jelly href={platform.href} download>
                Download for {platform.label}
                <span class="btn-meta">{platform.meta}</span>
              </a>
              <a class="btn btn-ghost" data-jelly href="/docs/getting-started">Read the guide</a>
            </div>
            <p class="install-note">
              {platform.requires} Check the download against{' '}
              <a href={platform.checksums}>{platform.checksumLabel}</a>.{' '}
              <a href={RELEASE.notes}>Release notes</a> &middot;
              <a href="https://github.com/Aiml3ss/whisper-face">Source on GitHub</a>
            </p>
          </div>
        ))
      }
    </div>

    <div
      class="terminal"
      data-platform="mac"
      role="img"
      aria-label="Terminal showing a first Mac install: it downloads Parakeet and Whisper Tiny, builds the speech helper, installs the login service, then asks for three permissions"
    >
      <div class="bar"><i></i><i></i><i></i></div>
      <pre><code><span class="muted"># an abridged first run</span>
<span class="p">you@mac</span> ~/Whisper Face $ <span class="c">./Install.command</span>

<span class="c">==</span> downloading the pinned Parakeet Unified model <span class="muted">(~565 MB)</span>
<span class="c">==</span> building the native Parakeet Unified helper
<span class="c">==</span> downloading Whisper Tiny <span class="muted">(~75 MB)</span>
<span class="c">==</span> installing the login LaunchAgent
<span class="c">==</span> Not finished yet: turn on "Whisper Face" under
<span class="c">==</span>   Input Monitoring, Accessibility, Microphone

<span class="muted">Then hold Right Option and start talking →</span></code></pre>
    </div>

    <div
      class="terminal"
      data-platform="windows"
      role="img"
      aria-label="Command prompt showing the steps Install.cmd runs on Windows: tools, the Python environment, the models, and the login task"
      hidden
    >
      <div class="bar"><i></i><i></i><i></i></div>
      <pre><code><span class="muted">:: the steps setup runs (preview, unverified on hardware)</span>
<span class="p">C:\Users\you\Whisper Face></span> <span class="c">Install.cmd</span>

<span class="c">==</span> installing uv, ffmpeg, Ollama
<span class="c">==</span> downloading qwen3.5:4b <span class="muted">(~3.4 GB)</span>
<span class="c">==</span> installing the locked Windows Python environment
<span class="c">==</span> downloading Whisper Tiny and large-v3-turbo
<span class="c">==</span> installing the Windows login task

<span class="muted">Then hold Right Alt and start talking →</span></code></pre>
    </div>
  </div>
</section>

<script>
  // Show the visitor's own platform first, and keep the tabs operable by
  // keyboard. Static-safe: with JS off the Mac panel is the one already
  // rendered visible and both downloads stay reachable by tabbing.
  const tabs = Array.from(
    document.querySelectorAll('#install .platform-tab'),
  ) as HTMLButtonElement[];
  // Panels and terminals both switch: a Windows visitor reading about
  // Install.cmd beside a macOS terminal is worse than no terminal at all.
  const panels = Array.from(
    document.querySelectorAll('#install .platform-panel, #install .terminal'),
  ) as HTMLElement[];

  function select(id: string, focus = false) {
    for (const tab of tabs) {
      const active = tab.dataset.platform === id;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      if (active && focus) tab.focus();
    }
    for (const panel of panels) {
      panel.hidden = panel.dataset.platform !== id;
    }
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => select(tab.dataset.platform as string));
    tab.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const step = event.key === 'ArrowRight' ? 1 : -1;
      const next = tabs[(tabs.indexOf(tab) + step + tabs.length) % tabs.length];
      select(next.dataset.platform as string, true);
    });
  }

  if (navigator.userAgent.includes('Windows')) select('windows');
</script>
