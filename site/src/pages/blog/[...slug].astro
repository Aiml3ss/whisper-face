---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} · Whisper Face`} description={post.data.description}>
  <Nav />
  <main id="main" class="wrap" style="padding-block:44px 80px">
    <article class="prose" style="margin-inline:auto">
      <p class="date" style="font-family:var(--mono);color:var(--brand-ink);font-weight:600;margin:0 0 6px">
        <time datetime={post.data.date}>{post.data.date}</time>
      </p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <Content />
    </article>
  </main>
  <Footer />
</Base>
