---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Local, one-click voice input for Mac. Hold a key, talk, and trustworthy text appears at your cursor. No account, no cloud, no word cap.',
} = Astro.props;

const ogImage = new URL('/og.png', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Cloudflare Web Analytics (cookieless). Paste the beacon token from the
// Cloudflare dashboard to enable; left empty it stays off.
const CF_ANALYTICS_TOKEN = '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#10b981" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script
      type="module"
      src="https://jelly-ui.com/dist/jelly.js"
      integrity="sha384-ftCoNMap6OQSid+PyZ/rndaaw9grzCxUOYiXbTN1fxw1OYuI95Gm/HwyjOknBIG5"
      crossorigin="anonymous"
    ></script>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('wf-theme');
          if (t) document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="dotgrid">
    <jelly-theme class="site-theme" mode="auto" accent="#10b981">
      <slot />
    </jelly-theme>
    <script>
      const jellyTheme = document.querySelector<HTMLElement>('jelly-theme.site-theme');
      const explicitTheme = document.documentElement.getAttribute('data-theme');
      if (explicitTheme) jellyTheme?.setAttribute('mode', explicitTheme);

      // Theme toggle (event delegation so it works for any [data-theme-toggle]).
      document.addEventListener('click', function (e) {
        const t = e.target as HTMLElement;
        const btn = t.closest ? t.closest('[data-theme-toggle]') : null;
        if (!btn) return;
        let cur = document.documentElement.getAttribute('data-theme');
        if (!cur) {
          cur = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        const next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        jellyTheme?.setAttribute('mode', next);
        try {
          localStorage.setItem('wf-theme', next);
        } catch (e) {}
      });

      // Shared soft-body release. CSS handles the press frame; this short
      // rebound keeps interactive objects consistent with the native app.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      function releaseJelly(target: EventTarget | null) {
        if (!(target instanceof HTMLElement) || reduceMotion.matches) return;
        const jelly = target.closest<HTMLElement>('[data-jelly]');
        if (!jelly) return;
        jelly.removeAttribute('data-jelly-releasing');
        requestAnimationFrame(() => {
          jelly.setAttribute('data-jelly-releasing', '');
          jelly.addEventListener(
            'animationend',
            () => jelly.removeAttribute('data-jelly-releasing'),
            { once: true },
          );
        });
      }
      document.addEventListener('pointerup', (e) => releaseJelly(e.target));
      document.addEventListener('pointercancel', (e) => releaseJelly(e.target));
      document.addEventListener('keyup', (e) => {
        if (e.key === 'Enter' || e.key === ' ') releaseJelly(e.target);
      });
    </script>
    {
      CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </body>
</html>
