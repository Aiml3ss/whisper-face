---
import '../styles/global.css';
import { motionStylesheet } from '../data/motion';

interface Props {
  title: string;
  description?: string;
}

// The four named motions, baked from the same spring constants the Mac app
// hands to CASpringAnimation. Inlined rather than bundled so the first paint
// already knows how a press feels.
const motionCss = motionStylesheet();

const {
  title,
  description = 'Local dictation for Mac, with a Windows preview. Hold a key, talk, and the text appears at your cursor. No account, no cloud, no word cap.',
} = Astro.props;

const ogImage = new URL('/og.png', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Cloudflare Web Analytics (cookieless). Paste the beacon token from the
// Cloudflare dashboard to enable; left empty it stays off.
const CF_ANALYTICS_TOKEN = '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#4cc9a2" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <style is:inline set:html={motionCss}></style>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var t = localStorage.getItem('wf-theme');
          if (t) root.setAttribute('data-theme', t);
        } catch (e) {}
        // Reduce Motion is switched off before first paint, and the flag is set
        // explicitly so the guarantee is auditable in the served HTML.
        try {
          var mq = matchMedia('(prefers-reduced-motion: reduce)');
          var apply = function () {
            root.setAttribute('data-jelly-motion', mq.matches ? 'reduce' : 'no-preference');
            dispatchEvent(new Event('jelly-motion-change'));
          };
          apply();
          mq.addEventListener('change', apply);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="clay">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import { playJelly } from '../data/jelly';

      const currentTheme = () =>
        document.documentElement.getAttribute('data-theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

      // The toggle reports "dark theme on" as its pressed state.
      const syncToggles = () => {
        const dark = String(currentTheme() === 'dark');
        document
          .querySelectorAll<HTMLElement>('[data-theme-toggle]')
          .forEach((btn) => btn.setAttribute('aria-pressed', dark));
      };
      syncToggles();
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncToggles);

      // Theme toggle (event delegation so it works for any [data-theme-toggle]).
      document.addEventListener('click', function (e) {
        const t = e.target as HTMLElement;
        const btn = t.closest ? t.closest('[data-theme-toggle]') : null;
        if (!btn) return;
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        syncToggles();
        try {
          localStorage.setItem('wf-theme', next);
        } catch (e) {}
      });

      // Choosing a destination from the phone menu closes it.
      document.addEventListener('click', function (e) {
        const link = (e.target as HTMLElement).closest?.('.nav-menu a');
        link?.closest('details')?.removeAttribute('open');
      });
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        const menu = document.querySelector<HTMLDetailsElement>('.nav-menu[open]');
        if (!menu) return;
        menu.removeAttribute('open');
        menu.querySelector<HTMLElement>('summary')?.focus();
      });

      // Shared soft-body motion. Every [data-jelly] object runs the same four
      // named springs the Mac app runs through CASpringAnimation: press squashes
      // on the way down, release springs back through a little overshoot, and
      // wobble/pop are fired by hand where a moment deserves them.
      const jellyTarget = (target: EventTarget | null) =>
        target instanceof HTMLElement ? target.closest<HTMLElement>('[data-jelly]') : null;

      document.addEventListener('pointerdown', (e) => playJelly(jellyTarget(e.target), 'press'));
      document.addEventListener('pointerup', (e) => playJelly(jellyTarget(e.target), 'release'));
      document.addEventListener('pointercancel', (e) =>
        playJelly(jellyTarget(e.target), 'release'),
      );
      document.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        if (e.key === 'Enter' || e.key === ' ') playJelly(jellyTarget(e.target), 'press');
      });
      document.addEventListener('keyup', (e) => {
        if (e.key === 'Enter' || e.key === ' ') playJelly(jellyTarget(e.target), 'release');
      });
    </script>
    {
      CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </body>
</html>
